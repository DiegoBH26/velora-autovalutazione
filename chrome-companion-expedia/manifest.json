{
  "manifest_version": 3,
  "name": "Velora · Expedia + Vrbo Chrome Companion",
  "version": "0.3.0",
  "description": "Legge su richiesta camere e tariffe soggiorno già visibili nelle pagine Expedia e Vrbo aperte nel Chrome personale; non esegue login.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.expedia.it/*",
    "https://*.expedia.com/*",
    "https://*.expedia.de/*",
    "https://*.expedia.fr/*",
    "https://*.expedia.es/*",
    "https://*.expedia.co.uk/*",
    "https://*.vrbo.com/*",
    "https://*.vrbo.co.uk/*",
    "https://*.vrbo.de/*",
    "https://*.vrbo.fr/*",
    "https://*.vrbo.es/*",
    "https://*.vrbo.it/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://diegobh26.github.io/velora-autovalutazione/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Velora Chrome Companion: usa i pulsanti di Ercole o Atlante"
  }
}
