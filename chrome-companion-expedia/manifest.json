{
  "manifest_version": 3,
  "name": "Velora · 5 OTA Companion",
  "version": "0.4.4",
  "description": "Lettura a richiesta di pagine visibili Expedia, Vrbo, Holidu, Hotels.com e Travelocity, senza login automatici o bypass.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.expedia.it/*",
    "https://*.expedia.com/*",
    "https://*.expedia.de/*",
    "https://*.expedia.fr/*",
    "https://*.expedia.es/*",
    "https://*.expedia.co.uk/*",
    "https://*.vrbo.com/*",
    "https://*.vrbo.co.uk/*",
    "https://*.vrbo.de/*",
    "https://*.vrbo.fr/*",
    "https://*.vrbo.es/*",
    "https://*.vrbo.it/*",
    "https://*.holidu.it/*",
    "https://*.holidu.com/*",
    "https://*.holidu.de/*",
    "https://*.holidu.fr/*",
    "https://*.holidu.es/*",
    "https://*.hotels.com/*",
    "https://*.travelocity.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://diegobh26.github.io/velora-autovalutazione/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Velora · 5 OTA Companion"
  }
}
